<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="tbl_create_transactions" author="liquibase">
        <createTable tableName="transactions">
            <column name="id" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="party_id" type="uuid"/>
            <column name="payer_id" type="uuid"/>
            <column name="payee_id" type="uuid"/>
            <column name="amount" type="numeric"/>
            <column name="status" type="varchar(50)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="party_id"
                referencedTableName="parties"
                referencedColumnNames="id"
                constraintName="transactions_party_id_fkey"/>
        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="payer_id"
                referencedTableName="participants"
                referencedColumnNames="id"
                constraintName="transactions_payer_id_fkey"/>
        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="payee_id"
                referencedTableName="participants"
                referencedColumnNames="id"
                constraintName="transactions_payee_id_fkey"/>
    </changeSet>
</databaseChangeLog>